# Copy to .env (gitignored) and fill in. The agent loads it automatically.

# LangSmith tracing: create a key at smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kube-sre
# EU-region LangSmith accounts also need:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# AWS (Bedrock). Locally a profile works; on EC2 the instance role is used.
# AWS_PROFILE=

# kube_sre settings (see src/kube_sre/config.py)
# KUBE_SRE_KUBE_CONTEXT=kind-kubesre
# KUBE_SRE_MODEL_ID=amazon.nova-lite-v1:0
