# Copy to .env (gitignored) and fill in. The agent loads it automatically.

# LLM (OpenAI)
OPENAI_API_KEY=
# KUBE_SRE_AGENT_MODEL=gpt-5-mini
# KUBE_SRE_JUDGE_MODEL=gpt-6.1-sol

# LangSmith tracing: create a key at smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kube-sre
# EU-region LangSmith accounts also need:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Kubernetes (see src/kube_sre/config.py)
# KUBE_SRE_KUBE_CONTEXT=kind-kubesre

# Agent run bounds
# KUBE_SRE_AGENT_RECURSION_LIMIT=40
# KUBE_SRE_AGENT_TIMEOUT_SECONDS=300
